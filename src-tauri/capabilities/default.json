{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:webview:allow-create-webview-window",
    "core:webview:allow-set-webview-zoom",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        { "name": "thunderbird", "cmd": "thunderbird", "args": true },
        { "name": "thunderbird-flatpak", "cmd": "flatpak", "args": true },
        { "name": "thunderbird-macos", "cmd": "open", "args": true },
        { "name": "thunderbird-win-64", "cmd": "C:\\Program Files\\Mozilla Thunderbird\\thunderbird.exe", "args": true },
        { "name": "thunderbird-win-32", "cmd": "C:\\Program Files (x86)\\Mozilla Thunderbird\\thunderbird.exe", "args": true },
        { "name": "thunderbird-win-appdata", "cmd": "$LOCALDATA/Mozilla Thunderbird/thunderbird.exe", "args": true }
      ]
    },
    "shell:allow-open",
    "updater:default",
    "process:allow-restart",
    "process:allow-exit",
    "dialog:allow-open",
    "dialog:allow-save",
    "window-state:default"
  ]
}
