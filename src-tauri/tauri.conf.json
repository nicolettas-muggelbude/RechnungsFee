{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RechnungsFee",
  "version": "0.1.0",
  "identifier": "de.rechnungsfee.app",
  "build": {
    "frontendDist": "../src/frontend/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "cd src/frontend && npm run dev",
    "beforeBuildCommand": "cd src/frontend && npm run build"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob: http://127.0.0.1:*",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost http://127.0.0.1:* https://openiban.com",
        "frame-src": "'self' blob: http://127.0.0.1:*",
        "object-src": "'self' blob:",
        "base-uri": "'self'",
        "form-action": "'self'"
      },
      "dangerousDisableAssetCspModification": ["style-src"]
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/nicolettas-muggelbude/RechnungsFee/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEYwNTBDOTQ5RjJEQTlCMzcKUldRM205cnlTY2xROEI2WUpkbFhyajQ3dS9hQlkvWkc5ZHhPZnNkS3hNcEJZMWZFbTFzZUdVbVgK"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "appimage",
      "nsis",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/256x256.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/backend"
    ],
    "resources": {
      "../THIRD_PARTY_LICENSES.txt": "THIRD_PARTY_LICENSES.txt"
    },
    "windows": {
      "nsis": {
        "languages": ["German"],
        "displayLanguageSelector": false,
        "installerHooks": "nsis/installer.nsh",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon_uninstall.ico"
      }
    }
  }
}
